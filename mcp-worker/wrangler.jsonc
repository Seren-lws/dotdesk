{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dotdesk-mcp",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "8ab0eb2b7dd04254a895930601579811"
    }
  ]
}
